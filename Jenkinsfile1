pipeline {
    
    agent any
    
    tools {
        jdk 'jdk17'
        maven 'maven3'
    }
    
    environment {
        SCANNER_HOME = tool 'sonar-scanner'
        SONAR_PROJECT_KEY = 'bloggingapp'
        SONAR_PROJECT_NAME = 'java'
        IMAGE_NAME = 'shark'
        CONTAINER_NAME = 'javaproject'
    }
    stages {
        stage('checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/srikz783/samplejava.git'
            }
        }
        stage('compile') {
            steps {
                sh 'mvn compile'
            }
        }
        stage('test') {
            steps {
                sh 'mvn test'
            }
        }
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh """
                    $SCANNER_HOME/bin/sonar-scanner \
                      -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                      -Dsonar.projectName=${SONAR_PROJECT_NAME} \
                      -Dsonar.java.binaries=target
                    """
                }
            }
        }
        stage('package') {
            steps {
                sh 'mvn package'
            }
        }
        stage('publish') {
            steps {
                script {
                withMaven(jdk: 'jdk17', maven: 'maven3', mavenSettingsConfig: 'nexus', traceability: true) {
                        sh "mvn clean deploy"
                    }
                }
            }
        }
        stage('docker image') {
            steps {
                sh 'docker build -t ${IMAGE_NAME} .'
            }
        }
        stage('docker container') {
            steps {
                sh """
                    docker stop ${CONTAINER_NAME} || true
                    docker rm ${CONTAINER_NAME} || true
                    docker run -d -p 8082:8080 --name ${CONTAINER_NAME} ${IMAGE_NAME}
                    
                    """
            }
        }
    }
}
